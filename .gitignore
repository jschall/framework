**/*.pyc
*.o.*
*.DS_Store
# Build outputs and temporary dirs
build/
**/build/
.dep/
**/.dep/

# Python bytecode caches
__pycache__/
**/__pycache__/

# Firmware artifacts
*.elf
*.bin
*.hex
*.map
*.dmp
*.list
*.srec

# Keep bootloader artifacts stored with boards
!**/boards/**/bootloader.bin
!**/boards/**/bootloader.elf
